# Local preview may use a fallback session secret, but production must set BP_SESSION_SECRET.
BP_SESSION_SECRET=replace-with-a-long-random-session-secret
# Optional: return 500 details locally only.
DEBUG_ERRORS=true
# Optional: block opportunistic runtime ALTER TABLE calls after migrations are enforced.
STRICT_SCHEMA=false
WAKE_TOKEN=replace-with-local-wake-agent-token
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BP_FOLDER_TOKEN=
FEISHU_BASE_APP_TOKEN=
FEISHU_BASE_TABLE_ID=
FEISHU_BASE_FIELD_FILE_NAME=File Name
FEISHU_BASE_FIELD_FILE_TOKEN=File Token
FEISHU_BASE_FIELD_SOURCE_URL=Source URL
FEISHU_BASE_FIELD_STATUS=Status
FEISHU_BASE_FIELD_UPLOADED_BY=Uploaded By
BP_UPLOAD_MAX_BYTES=20971520

# Optional Worker-side ModelBest / OpenAI-compatible LLM settings.
# Set LLM_API_KEY locally or as a Cloudflare secret; do not commit real keys.
# LLM_BASE_URL=https://llm-center.modelbest.cn/llm/v1
# LLM_API_KEY=replace-with-your-worker-api-key
# LLM_MODEL=deepseek-v3.2
# LLM_TIMEOUT_SECONDS=55
